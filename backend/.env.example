# ---- Server ----
NODE_ENV=development
PORT=4000
# Where the React app is served from (used for redirects after OAuth).
APP_URL=http://localhost:5173
# Public URL of this API. OAuth callbacks are built from it:
#   Google: ${API_URL}/api/auth/google/callback
#   Slack:  ${API_URL}/api/slack/callback
API_URL=http://localhost:4000
JWT_SECRET=replace-with-a-long-random-string

# ---- Infrastructure ----
DATABASE_URL=postgres://dispatch:dispatch@localhost:5432/dispatch
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# ---- Google OAuth (required for login) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Slack OAuth (required for the Connect Slack button) ----
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ---- Scheduler behaviour ----
# Jobs a single worker process runs in parallel.
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the same sender account.
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Hard ceiling on sends per sender per clock hour. A request may ask for less, never more.
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Delivery attempts per email before it is marked failed.
MAX_ATTEMPTS=3
# Ethereal sender accounts to create automatically when none exist.
ETHEREAL_ACCOUNTS=3
